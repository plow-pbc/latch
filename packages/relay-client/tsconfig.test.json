{
  // FakeRelay is imported by two very different callers: vitest (which reads
  // the .ts directly) and the Electron harness in apps/desktop/scripts, which
  // cannot load TypeScript at all. So it is compiled here as well. It has no
  // imports outside node: and ws — deliberately, see the file's own header — so
  // it builds standalone with no project references.
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "test",
    "outDir": "dist-test",
    "composite": true
  },
  "include": ["test/fakeRelay.ts"]
}
