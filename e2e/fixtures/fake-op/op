#!/usr/bin/env node
/**
 * Fake 1Password CLI (`op`) for the integration tier. Implements exactly the
 * invocations vendor/browser-server/seed_op_broker/cli.py makes, backed by a
 * JSON vault at $FAKE_OP_VAULT, so the REAL python broker code (origin check,
 * error classification, audit) runs against controllable data.
 *
 * Vault file: [{ "id", "title", "category", "additional_information",
 *   "urls": [{"href": "...", "primary": true}],
 *   "fields": [{"label": "password", "value": "...", "type": "CONCEALED"}] }]
 */
"use strict";
const fs = require("node:fs");

function vault() {
  return JSON.parse(fs.readFileSync(process.env.FAKE_OP_VAULT, "utf8"));
}

const args = process.argv.slice(2);
const out = (s) => process.stdout.write(s);
const die = (msg) => {
  process.stderr.write(msg + "\n");
  process.exit(1);
};
const flagValue = (flag) => {
  const i = args.indexOf(flag);
  return i !== -1 && i + 1 < args.length ? args[i + 1] : null;
};

if (args[0] === "whoami") {
  out(JSON.stringify({ email: "fake-service-account@example.com" }) + "\n");
} else if (args[0] === "vault" && args[1] === "list") {
  out(JSON.stringify([{ name: "agents" }]) + "\n");
} else if (args[0] === "item" && args[1] === "list") {
  let items = vault();
  const cats = flagValue("--categories");
  if (cats) items = items.filter((i) => cats.split(",").includes(titleCase(i.category)));
  out(JSON.stringify(items.map(summary)) + "\n");
} else if (args[0] === "item" && args[1] === "get") {
  const id = args[2];
  const item = vault().find((i) => i.id === id || i.title === id);
  if (!item) die(`[ERROR] "${id}" isn't an item`);
  const field = flagValue("--field");
  if (args.includes("--otp")) {
    out("000000");
  } else if (field) {
    const f = (item.fields || []).find(
      (f) => (f.label || "").toLowerCase() === field.toLowerCase(),
    );
    if (!f) die(`[ERROR] no field "${field}" found in item`);
    out(f.value + "\n");
  } else {
    out(JSON.stringify(item) + "\n");
  }
} else {
  die("[ERROR] unknown op invocation: " + args.join(" "));
}

function summary(item) {
  return {
    id: item.id,
    title: item.title,
    category: item.category,
    additional_information: item.additional_information || "",
    urls: item.urls || [],
  };
}

function titleCase(cat) {
  // op's --categories takes "Login"; vault stores "LOGIN".
  return (cat || "").charAt(0) + (cat || "").slice(1).toLowerCase();
}
