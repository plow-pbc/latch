<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Bundled Python runtime + Playwright's node driver, under the hardened
       runtime: JIT for the driver, unsigned-executable-memory as a safety
       margin for ctypes/ffi. No library-validation exemption — every .so we
       ship carries our team id. -->
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
</dict>
</plist>
