<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Minimum for Electron under the hardened runtime: V8 needs JIT.
       Deliberately nothing else — the app spawns sandbox-exec and helper
       processes, which hardened runtime permits without extra entitlements. -->
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
</dict>
</plist>
