<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Minimum for Electron under the hardened runtime: V8 needs JIT.
       Deliberately nothing else — the app spawns sandbox-exec and helper
       processes, which hardened runtime permits without extra entitlements. -->
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.automation.apple-events</key>
  <true/>
  <!-- The vault's master key lives in the data-protection Keychain under this
       access group (vaultKeyStore.ts). The group — not the bundle id — is what
       the item is keyed to, so the app can be renamed or re-identified without
       orphaning anyone's vault. Team prefix required by macOS. -->
  <key>keychain-access-groups</key>
  <array>
    <string>3559PD337Z.co.plow.vault</string>
  </array>
  <!-- The data-protection keychain refuses callers with no application
       identity (errSecMissingEntitlement), so the group alone is not enough.
       Restricted, like the group: both are authorized by the embedded
       provisioning profile (electron-builder.yml `provisioningProfile`), and
       AMFI kills the app at exec if that profile is missing. -->
  <key>com.apple.application-identifier</key>
  <string>3559PD337Z.co.plow.domo-desktop</string>
</dict>
</plist>
