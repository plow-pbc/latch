.DS_Store

# TypeScript stack build artifacts
node_modules/
packages/*/dist/
apps/*/dist/
*.tsbuildinfo

# electron-builder output (signed app + DMG)
apps/desktop/release/

# Design specs live outside the repo (see PR descriptions for rationale)
docs/superpowers/specs/
docs/superpowers/plans/

vendor/providers/
# The pre-namespace layout. Every checkout that fetched before providers/
# existed still has this tree on disk, and renaming the line above rather than
# widening it would leave two ~13 MB binaries untracked and UNIGNORED there.
# Delete once no live checkout predates that move.
vendor/gog/
vendor/python-runtime/
vendor/camoufox-browser/
vendor/downloads/

# a stray bw run once defaulted its app data here
Library/
packages/native-keychain/build/
