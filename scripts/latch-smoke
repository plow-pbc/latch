#!/usr/bin/env python3
"""Prove an installed Latch works: one real MCP call, verified in the audit log.

The unit suite never opens a socket to a real relay (README-ts.md § Integration
coverage). This is the leg that does — MCP client → Plow relay → device socket →
`@domo/mcp-server` → the executor — and the audit log is the proof, not the
client's reply. A reply can come from a deferred handle or a half-working path;
an `exec_end` carrying our intent's id cannot.

One process on purpose. Send and Verify used to be two pasted blocks bridged by
copied shell variables across three interpreters, and every bug in them lived in
that seam: a credential in an error body, a success declared at `exec_start`
before any terminal event, and a wall-clock bound that could report "ruled out"
having checked nothing. Here the correlation id is held in a variable, the
baseline is a line count rather than a timestamp, and there is no quoting layer.

The nonce rides `goal`, never argv. `RuleKey.compute` hashes the capability set
and deliberately excludes goal text, so a fixed argv means one pre-seeded Always
Allow rule matches every run — which is what makes a *deterministic* unattended
smoke possible under Ask or Approve mode. A nonce in argv would mint a new rule
key each time and raise a dialog forever. Under the default adversarial mode
the reviewer decides without a dialog and stored rules are vetoed, so the run
is unattended either way — just not deterministic.
"""
import argparse
import json
import os
import shlex
import subprocess
import sys
import time
import urllib.error
import urllib.request

# The wire shape is NOT generic JSON-RPC: the server validates that the body's
# method and tool name agree with headers declaring them, and every request
# carries its envelope in `params._meta` — modern MCP is per-request, so there
# is no initialize handshake and no session to open first.
# `packages/mcp-server/test/client.ts` is the authority; keep this in step with
# it and with `PROTOCOL_REVISION` in `handler.ts`.
REVISION = "2026-07-28"
# How long a call whose send RAISED is given to show up. `intent_received` is
# written the moment one arrives, so this is generous; it exists so a typo'd
# --url does not cost the full window.
ARRIVAL_GRACE_S = 20
# Every read gets at least this long, even past the deadline. Spending the
# budget down to zero starved the LAST read, so a timed-out ssh run reported
# "the audit log stopped being readable" instead of the verdict it had the
# evidence for — the wrong cause, on the path where reads are slowest.
READ_FLOOR_S = 5.0
# ...and a send needs enough left to plausibly settle. `remaining() > 0` let a
# baseline read that nearly consumed the window still fire a call with
# milliseconds to answer in, which raises a dialog nothing can then verify.
MIN_SEND_S = 2.0


class _NoRedirect(urllib.request.HTTPRedirectHandler):
    """Never follow a redirect.

    `urllib` carries a request's custom headers across one — verified on this
    Python: a 302 to another origin delivered `Authorization: Bearer …` to that
    origin in full. The relay endpoint is configured, so a 30x from it is not
    something to follow silently; returning None here makes `urlopen` raise the
    3xx as an `HTTPError` instead.
    """

    def redirect_request(self, *_args, **_kwargs):
        return None


_OPENER = urllib.request.build_opener(_NoRedirect)


def read_token(token_file):
    """`(token, problem)` — the bearer, or why there is none.

    In `main` rather than inside `send`, so an unreadable path is found before
    the baseline read has spent budget and before a nonce is printed. That is
    also why these refusals need no retraction: nothing was ever offered.

    Text mode decodes, so a binary file raises `UnicodeDecodeError` — a
    `ValueError`, not an `OSError`, which is how it escaped the first guard.
    """
    try:
        with open(token_file) as handle:
            permissive = _permissive(handle, token_file)
            if permissive:
                return None, permissive
            token = handle.read().strip()
    except OSError as error:
        return None, f"{token_file}: {error.strerror}"
    except UnicodeDecodeError:
        return None, f"{token_file} is not text — it must hold the bearer token, on one line"
    if not token:
        return None, f"{token_file} is empty — it must hold the bearer token, on one line"
    if "\r" in token or "\n" in token:
        # `.strip()` removes SURROUNDING whitespace only, so a token pasted
        # across two lines keeps its newline — and `putheader` refuses it with
        # a message that quotes the header value.
        return None, f"{token_file} has a line break inside the token"
    return token, None


def _permissive(handle, path):
    """The refusal for a credential file another account can read, or None.

    `fstat` on the open handle, not `stat` on the path, so the mode checked is
    the file actually being read. The 0600 contract is documented at every
    site that says to create one of these files; enforcing it here is what
    keeps a hand-made 0644 registration from silently sharing its bearer.
    """
    if os.fstat(handle.fileno()).st_mode & 0o077:
        return f"{path} is readable by other accounts — chmod 600 it"
    return None


def read_config(config_file):
    """`(url, token, problem)` from a recorded client registration.

    The file is the `_mcpConfig` block the Agents tab renders, saved verbatim
    at the known path `docs/AUTONOMOUS-OPERATION.md` (Stop 3) names:
    `~/.latch/<install>.json`. Every refusal names keys and paths, never
    values — an Authorization header is a credential.
    """
    try:
        with open(config_file) as handle:
            permissive = _permissive(handle, config_file)
            if permissive:
                return None, None, permissive
            parsed = json.load(handle)
    except OSError as error:
        return None, None, f"{config_file}: {error.strerror}"
    except (UnicodeDecodeError, ValueError):
        return None, None, f"{config_file} is not the JSON block the Agents tab renders"
    servers = parsed.get("mcpServers") if isinstance(parsed, dict) else None
    if not isinstance(servers, dict) or len(servers) != 1:
        return None, None, (f"{config_file} must hold exactly one entry under"
                            " mcpServers — one file per install")
    (server,) = servers.values()
    url = server.get("url") if isinstance(server, dict) else None
    auth = server.get("headers", {}).get("Authorization") if isinstance(server, dict) else None
    if not url or not isinstance(url, str):
        return None, None, f"{config_file} has no url under its mcpServers entry"
    if not isinstance(auth, str) or not auth.startswith("Bearer "):
        return None, None, (f"{config_file} has no `Bearer` Authorization header"
                            " under its mcpServers entry")
    token = auth[len("Bearer "):].strip()
    if not token or "\r" in token or "\n" in token:
        return None, None, f"{config_file}'s Authorization header holds no usable token"
    return url, token, None


def remote_cat(log_path, home):
    """The shell command that reads the log on the far side.

    Three jobs. `$HOME` expands THERE — the default home starts with `~`, and
    `shlex.quote` makes it a literal, so the remote shell would look for a
    directory actually named `~`. And a file that does not exist yet exits 3,
    distinctly from every other way `cat` can fail: a fresh install has no
    audit log until something is approved (`just audit` says so), and that is
    the case this script is written for, while a dead host and a permission
    refusal are not the same answer at all.
    """
    def q(p):
        return f'"$HOME"/{shlex.quote(p[2:])}' if p.startswith("~/") else shlex.quote(p)

    quoted = q(log_path)
    # And the HOME, at exit 4, ahead of both. A missing log is normal on a
    # fresh install, so collapsing the two makes a wrong --home over ssh
    # silent — and remote is where it is most likely wrong, since the
    # environment cannot answer there and the default is the PACKAGED install.
    return (f"if [ ! -d {q(home)} ]; then exit 4; "
            f"elif [ -e {quoted} ]; then cat -- {quoted}; else exit 3; fi")


def read_log(log_path, ssh, budget, home):
    """`(records, problem)` — every parseable audit record, or why there are none.

    `budget` is what is left of the run's single deadline. An ssh read that
    stalls is otherwise unbounded, and it sits INSIDE the poll loop, so a
    hung host meant `--timeout` bounded nothing at all.

    A read that FAILED and a log with no evidence in it are different answers,
    and collapsing them is how a checker reports "ruled out" having opened
    nothing. A log that does not exist YET is the second kind: `AuditLog`
    creates the file on its first record, so a freshly installed build has none
    until something is approved. A permission error, a dead host and a
    `BatchMode` refusal are the first kind, and over ssh they are not even in
    the set of causes the timeout branch names.
    """
    if ssh:
        try:
            proc = subprocess.run(
                ["ssh", "-o", "ConnectTimeout=8", "-o", "BatchMode=yes", ssh, remote_cat(log_path, home)],
                capture_output=True, text=True, timeout=budget,
            )
        except subprocess.TimeoutExpired:
            return [], f"ssh {ssh}: read did not finish within the window"
        if proc.returncode == 4:
            return [], f"no such home on {ssh}: {home}"
        if proc.returncode == 3:
            return [], None
        if proc.returncode != 0:
            # The LAST line, not the first: a known-hosts warning or a login
            # banner precedes the real error, and the one line that survives is
            # the operator's only clue about which of --home or --ssh is wrong.
            detail = [line for line in proc.stderr.strip().splitlines() if line.strip()]
            return [], f"ssh {ssh}: {detail[-1] if detail else 'exit ' + str(proc.returncode)}"
        raw = proc.stdout
    else:
        try:
            with open(log_path, errors="replace") as handle:
                raw = handle.read()
        except FileNotFoundError:
            raw = ""
        except OSError as error:
            return [], f"{log_path}: {error.strerror}"
    records = []
    for line in raw.splitlines():
        try:
            records.append(json.loads(line))
        except ValueError:
            continue
    return records, None


def send(url, token, argv, goal, budget, apple_events=False):
    """POST one `tools/call`. Returns None, or `(reason, unknown, hint)`.

    `budget` is what is left of the run's deadline, and it bounds the read.
    Hard-coding 90s here meant `--timeout 1` blocked for 91 seconds against a
    relay that accepts and never answers — measured, not supposed.

    `unknown` is the difference between a call that was refused and one whose
    fate nobody knows. Only the first is a reason to stop: the second is
    resolved by the poll loop, which is already primed with the baseline and
    holds the nonce, so handing it back as manual work would be giving up at
    the moment this is best equipped to answer it.

    `hint` is the line to print if the poll then finds nothing, and each branch
    carries its OWN — a shared one was wrong the moment `isError` became
    non-terminal, because it blamed a send that had demonstrably returned 200.

    The error body is NEVER printed. An authenticated response can repeat the
    bearer credential back, and this repo's contract (CLAUDE.md) is that such a
    response never becomes a verdict or a log line in any encoding. The status
    alone carries what the body was here for: the relay refuses with 401/403
    before the MCP handler is reached, and the handler's own refusals are 4xx
    from a server that already authenticated you.
    """
    name = "plow_run_command"
    # apple_events rides the tool arguments only when asked: it is the grant the
    # packaged-app send gate needs, and without it a `send`-shaped argv reaches
    # the sandbox's appleevent-send denial instead of exercising the real path.
    tool_args = {"argv": list(argv), "goal": goal}
    if apple_events:
        tool_args["apple_events"] = True
    body = json.dumps({
        "jsonrpc": "2.0", "id": 1, "method": "tools/call",
        "params": {
            "name": name,
            "arguments": tool_args,
            "_meta": {
                "io.modelcontextprotocol/protocolVersion": REVISION,
                "io.modelcontextprotocol/clientInfo": {"name": "latch-smoke", "version": "1"},
                "io.modelcontextprotocol/clientCapabilities": {},
            },
        },
    }).encode()
    try:
        request = urllib.request.Request(url, data=body, method="POST", headers={
            "Authorization": "Bearer " + token,
            "Content-Type": "application/json",
            "Accept": "application/json, text/event-stream",
            "MCP-Protocol-Version": REVISION,
            "MCP-Method": "tools/call",
            "MCP-Name": name,
        })
    except ValueError as error:
        # Its own branch, and its message is safe to quote: `full_url`'s setter
        # rejects a URL with no scheme and names the URL, which the operator
        # supplied and which this file already prints. Nothing has touched the
        # headers yet, so the credential cannot be in it.
        return (f"could not reach {url}: {error}.\n"
                "  The request never left this Mac; nothing was written to the log.", False, None)
    try:
        with _OPENER.open(request, timeout=budget) as response:
            payload = json.load(response)
    except urllib.error.HTTPError as error:
        # A redirect, which this deliberately did not follow. Terminal: no
        # intent exists, and the operator's fix is the --url, not a retry.
        # The Location is NOT quoted — it is server-authored, and naming where
        # something tried to send the credential is not worth putting the
        # attacker's string on screen.
        if 300 <= error.code < 400:
            return (f"HTTP {error.code} — the relay tried to redirect, and this does not"
                    " follow redirects.\n"
                    "  Following one would hand the bearer token to wherever it pointed."
                    " Check --url.", False, None)
        # A RESPONSE arrived, so this branch actually knows something. A 4xx is
        # the relay or the MCP handler saying it refused. A 5xx is neither —
        # RELAY_TIMEOUT_MS is the relay abandoning an exchange it has ALREADY
        # forwarded, with the device holding the intent and the dialog up.
        if error.code >= 500:
            return (f"HTTP {error.code} — the relay gave up on an exchange it may"
                    " already have forwarded.", True,
                    "  The relay gave up mid-exchange — see UNVERIFIED above. If it never"
                    " forwarded it, that is cause 1.")
        return (f"HTTP {error.code} — refused before it became an intent.\n"
                "  Nothing was written to the audit log. 401/403 is the relay or the"
                " credential; another 4xx is the MCP handler.", False, None)
    except Exception as error:
        # A RESPONSE is evidence. AN EXCEPTION IS NOT — and seven rounds of
        # review went into learning that. Each one classified some exception as
        # proof the call had or had not gone out, and each was wrong for one
        # more subclass: a 5xx, then every transport error, then a bare
        # `ConnectionResetError`, then `IncompleteRead`, then a scheme-less
        # URL, then `InvalidURL` and a `UnicodeEncodeError` out of `putheader`.
        #
        # So this no longer asks. There are no sides to put an exception on:
        # anything that is not a response means the call's fate is unknown, and
        # the audit log — the one thing that actually knows — is read below. A
        # call that never left costs a short grace window, which is the cheap
        # error; asserting an intent does not exist while the dialog is up is
        # the expensive one.
        # The CLASS NAME, never the message. `putheader` raises
        # `ValueError("Invalid header value %r" % value)` and the value here is
        # `b"Bearer <token>"` — verified by driving a real `urlopen` with a
        # newline in the token: the message carries the credential in full.
        # This branch catches every exception there is, so no audit of which
        # messages are safe could stay true; the class name always is.
        return (type(error).__name__, True,
                "  The send never completed — see UNVERIFIED above, which is the"
                " likeliest cause of all three.")
    # Neither absence is proof of success — that is the audit log — but either
    # presence is proof of failure, and saying so now beats a 2-minute timeout.
    if payload.get("error") is not None:
        # NOT the server's text. This is an AUTHENTICATED response, so its
        # error field is server-authored and can reflect the request back —
        # the same rule the catch-all follows, and it was missing here.
        return ("the relay answered with a JSON-RPC error.\n"
                "  Refused before it became an intent; nothing was written to the log.", False, None)
    # `or {}` because a present-but-null `result` is None, and `.get` on it
    # raises rather than answering.
    if (payload.get("result") or {}).get("isError"):
        # NOT terminal, and not a claim that no intent was created. An
        # ordinary denial and an executor failure BOTH come back this way,
        # after their audit records already exist — so exiting here reported
        # "nothing reached this Mac" about a call the owner had just refused.
        # Polling resolves it to the DENIED or FAILED it actually is.
        return ("the tool returned isError, which an ordinary denial also does.", True,
                "  Cause 2 is the likeliest: isError is ALSO how the MCP layer refuses"
                " before an intent exists, and the send itself returned 200.")
    return None


def split_command(raw):
    """`(options, command)`, split at the first `--`.

    Done by hand rather than with an `argparse` positional because the commands
    worth smoking carry flags of their own — `gog gmail search q --json` — and
    argparse rejects an option it does not recognise wherever it appears. A
    separator also keeps a mistyped script flag an error instead of silently
    becoming part of the command, which `parse_known_args` would not.
    """
    if "--" not in raw:
        return raw, []
    cut = raw.index("--")
    return raw[:cut], raw[cut + 1:]


def first(records, event):
    return next((r for r in records if r.get("event") == event), None)


def verdict(events, nonce, expired, since=0):
    """The whole outcome table, pure over the audit records.

    Returns `(exit_code, lines, arrived)`, or None while the call is still in
    flight and the window is still open. `arrived` is whether anything carrying
    the nonce was found at all, which is what the hints in `main` annotate —
    guarding those on a non-zero exit instead would print "the send failed"
    under a `DENIED`, which is itself proof the send arrived.

    Pure on purpose: this is where every bug in the two pasted shell blocks
    this script replaces actually lived, and a function over a list of records
    is the only version of it a test can reach.

    `intent_received` is the correlation point — it carries the goal, and so
    the nonce. Everything after it is anchored to its `intentId`, so no other
    traffic on a busy install can satisfy one of these conditions on a
    different call's record. Matching the nonce alone would not do: it is
    written BEFORE the decision, so a call the owner denied still carries it.
    """
    received = next((r for r in events if r.get("event") == "intent_received"
                     and nonce in str(r.get("goal", ""))), None)
    if received is None:
        if not expired:
            return None
        # The ONE scan that needs bounding: an `intent_rejected` carries no
        # nonce, so an old one is indistinguishable from this call's. Nothing
        # else does — the nonce carries a timestamp AND this process's pid, so
        # it identifies this call across the whole file. Slicing the records
        # instead would put correlation itself at the mercy of a count taken by
        # a separate read: a line still being appended when that read lands
        # parses as garbage and is dropped, the count comes back one short, and
        # the slice cuts off this call's own `intent_received`.
        # A log that SHRANK — `AuditLog.clear()` truncates — leaves `since`
        # indexing past the end, and the slice would be empty: "ruled out"
        # over records nothing examined, which is the shape this whole
        # function exists to prevent. A baseline that no longer indexes
        # anything bounds nothing, so scan it all.
        bound = since if since <= len(events) else 0
        rejected = [r for r in events[bound:] if r.get("event") == "intent_rejected"]
        lines = [f"TIMEOUT — nothing carrying {nonce}. Three causes:",
                 "  1. it never reached this install (wrong install, credential, or socket)",
                 "  2. refused in the MCP layer before an intent existed — writes NO audit line",
                 "  3. rejected at validate (wrong device / expired / replayed nonce), which",
                 "     writes intent_rejected WITHOUT the nonce:"]
        lines += ["     " + json.dumps(r) for r in rejected[-2:]]
        if not rejected:
            lines.append("     (none since this call started — cause 3 ruled out)")
        return 1, lines, False

    mine = [r for r in events if r.get("intentId") == received.get("intentId")]
    decision = first(mine, "intent_decision")
    if decision is not None and decision.get("decision") == "deny":
        return 1, [json.dumps(decision),
                   "DENIED — the owner refused it. The relay and the device both worked."], True
    end = first(mine, "exec_end")
    if end is not None:
        lines = [json.dumps(r) for r in (first(mine, "exec_start"), end) if r is not None]
        # `exec_start` alone was never proof: it is written before the spawn.
        # A run this Mac killed is not a command that succeeded either, and
        # `reaped` is the only place that difference survives.
        if end.get("exit_code") == 0 and not end.get("reaped"):
            return 0, lines + ["OK — it executed and exited 0. The whole path works."], True
        what = "was reaped by this Mac" if end.get("reaped") else f"exited {end.get('exit_code')}"
        return 1, lines + [f"FAILED — it ran and {what}."], True
    error = first(mine, "exec_error")
    if error is not None:
        return 1, [json.dumps(error), "FAILED — the executor threw before the command ran."], True
    if not expired:
        return None
    if decision is None:
        return 1, ["TIMEOUT — it reached this Mac and no decision was recorded in the window.",
                   "  Not a plumbing problem: an adversarial review may still be running, or an",
                   "  Ask-mode dialog is sitting unanswered. Raise --timeout, or under Ask mode",
                   "  seed an Always Allow rule for an unattended run."], True
    start = first(mine, "exec_start")
    if start is None:
        return 1, ["TIMEOUT — approved, never started. exec_start is written before the spawn,",
                   "  so its absence means the executor was never reached. Check the app is running."], True
    return 1, [json.dumps(start),
               "TIMEOUT — started, still running. Re-run to read its exec_end, or raise --timeout."], True


def main():
    # Progress is the point of the waiting lines, and Python block-buffers
    # stdout when it is a pipe — so `latch-smoke | tee run.log` showed nothing
    # at all until the run ended, which is exactly when it stops mattering.
    sys.stdout.reconfigure(line_buffering=True)
    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    parser.add_argument("--url", default=os.environ.get("MCP_URL"),
                        help="the install's mcpUrl (env: MCP_URL)")
    parser.add_argument("--token-file", default=os.environ.get("TOKEN_FILE"),
                        help="a 0600 file holding the bearer token (env: TOKEN_FILE)")
    parser.add_argument("--config", default=os.environ.get("LATCH_CONFIG"),
                        help="a 0600 file holding the Agents tab's _mcpConfig block —"
                             " supplies url and token together; the recorded-registration"
                             " convention is ~/.latch/<install>.json (env: LATCH_CONFIG)")
    # REQUIRED. There is no default and no environment fallback: every wrong
    # home this script has produced came from it choosing one, and a chosen
    # home that is wrong reads as a fresh install rather than an error. The
    # justfile owns the from-source answer — `--home "$(just --evaluate
    # apphome)"` — and the packaged one is a fixed path the skill spells out.
    parser.add_argument("--home", required=True,
                        help='the instance home. Packaged: "~/Library/Application '
                             'Support/Plow-Latch". From source: "$(just --evaluate apphome)"')
    parser.add_argument("--ssh", default=None, metavar="USER@HOST",
                        help="read the audit log on another Mac over ssh")
    parser.add_argument("--timeout", type=int, default=120,
                        help="seconds to wait for a terminal event (default: 120)")
    parser.add_argument("--apple-events", action="store_true",
                        help="request the apple_events capability — the packaged-app send gate, "
                             "so an osascript-send argv exercises the real path instead of the denial")
    parser.epilog = "Everything after `--` is the command to run."
    options, command = split_command(sys.argv[1:])
    args = parser.parse_args(options)
    if args.config and (args.url or args.token_file):
        parser.error("--config supplies both url and token — drop --url/--token-file"
                     " (and MCP_URL / TOKEN_FILE) or drop --config")
    if not args.config and (not args.url or not args.token_file):
        parser.error("pass --config (or LATCH_CONFIG), or both --url and --token-file"
                     " (or MCP_URL / TOKEN_FILE)")
    # `--home "$(just --evaluate apphome)"` yields "" when that command fails,
    # which is the likeliest way the documented invocation breaks — and falling
    # through to the packaged install would read the wrong one silently.
    if not args.home.strip():
        parser.error('--home was empty — did `just --evaluate apphome` fail?')
    # Below the send floor there is no run to have: the guard downstream would
    # refuse every time, naming the window rather than the flag that set it.
    # `<=`, not `<`: the baseline read always consumes something, so exactly
    # MIN_SEND_S leaves less than that by the time the send is reached and the
    # downstream guard refuses every time.
    if args.config:
        args.url, token, token_problem = read_config(args.config)
        credential_flag = "--config (or LATCH_CONFIG)"
    else:
        token, token_problem = read_token(args.token_file)
        credential_flag = "--token-file (or TOKEN_FILE)"
    if token_problem is not None:
        print(f"REFUSED — {token_problem}.")
        print(f"  Nothing was sent. That path is {credential_flag}.")
        return 1
    if args.timeout <= MIN_SEND_S:
        parser.error(f"--timeout must be more than {MIN_SEND_S:.0f}s — at or below it the"
                     " log read leaves a call no time to answer, and nothing is sent")
    # A FIXED default, so one Always Allow rule covers every run. Passing a
    # command is how the gog path is smoked; that one needs its own rule.
    argv = command or ["/bin/echo", "latch-smoke"]

    home = args.home if args.ssh else os.path.expanduser(args.home)
    log_path = os.path.join(home, "device", "audit.ndjson")
    nonce = f"latch-smoke-{time.strftime('%Y%m%dT%H%M%SZ', time.gmtime())}-{os.getpid()}"
    # WHICH home, always. A missing `audit.ndjson` is deliberately not a
    # problem — a fresh install has none — so a wrong --home looks exactly like
    # one, and the run reports a confident timeout about the wrong install.
    print(f"home={home}")
    if not args.ssh and not os.path.isdir(home):
        print(f"REFUSED — no such home: {home}")
        print("  Nothing was sent. A home that does not exist is a wrong --home, not a")
        print('  fresh install. From source: --home "$(just --evaluate apphome)".')
        return 1

    # ONE deadline, started before any blocking call. `--timeout` is the whole
    # run's budget, not the poll loop's: it used to start after the send, so a
    # relay that accepts and never answers made `--timeout 1` take 91 seconds
    # (measured), and a stalled ssh read inside the loop was unbounded
    # entirely. Every blocking call below gets what is left of it.
    full_deadline = time.monotonic() + args.timeout
    deadline = full_deadline

    def remaining():
        return max(0.0, deadline - time.monotonic())

    # Read BEFORE sending, and refuse on a read that failed. This is the one
    # moment where refusing costs nothing: past it, the call has raised a
    # dialog on someone's Mac that nothing here can then verify. It is the same
    # reasoning the send-side guards use, one layer down.
    baseline, problem = read_log(log_path, args.ssh, max(remaining(), READ_FLOOR_S), home)
    if problem is not None:
        print(f"REFUSED — cannot read the audit log: {problem}")
        print("  Not sending: a call this cannot verify would still raise a dialog.")
        print("  A missing log is NOT this — that is normal on a fresh install and reads")
        print("  as empty. This is a host, a permission, or an unreadable --home.")
        return 1
    # Positional, and it bounds ONE thing: the nonce-less `intent_rejected`
    # scan. No clock is involved — the operator's clock and the target's are
    # not the same clock on the ssh path, and a skewed bound reports "ruled
    # out" having checked nothing, which tells someone to stop looking.
    since = len(baseline)

    if remaining() < MIN_SEND_S:
        print(f"REFUSED — under {MIN_SEND_S:.0f}s left of the {args.timeout}s window"
              " after reading the log.")
        print("  Nothing was sent: a call with no time to answer still spends a review")
        print("  or raises a dialog on the target.")
        print("  Raise --timeout.")
        return 1
    # BEFORE the send, because the send is when a handle is most wanted: it is
    # given the whole remaining budget, so against a relay that accepts and
    # never answers this is the only thing on screen for a long time. A
    # terminal refusal retracts it rather than the print being delayed — an
    # operator who has already scrolled past it needs to be told it is void.
    print(f"nonce={nonce}")
    sent = send(args.url, token, argv, f"smoke test: {nonce}", remaining(), apple_events=args.apple_events)
    if sent is not None:
        reason, unknown, _hint = sent
        if not unknown:
            print(f"REFUSED — {reason}")
            # "no intent was created" holds for all five terminal branches;
            # "nothing was sent" is true of only two of them — a 4xx, a
            # JSON-RPC error and a redirect all sent something and got an
            # answer back.
            print("  The nonce above corresponds to no call: no intent was created.")
            return 1
        print(f"UNVERIFIED — {reason}")

    # `intent_received` is written on arrival, before the dialog, so a short
    # look answers "did it get there?" from evidence rather than from the
    # exception's class. Extended to the rest of the window the moment it
    # appears — and never PAST it: the grace is a floor on attention, not an
    # extension of the budget.
    grace = sent is not None
    if grace:
        deadline = min(full_deadline, time.monotonic() + ARRIVAL_GRACE_S)
    print(f"waiting up to {remaining():.0f}s"
          f"{' for it to arrive at all' if grace else ' for a terminal event'}")
    # The baseline was read from the same path a moment ago; records in it are
    # evidence the path is right, which is all the hint below asserts against.
    saw_any = bool(baseline)
    while True:
        events, problem = read_log(log_path, args.ssh, max(remaining(), READ_FLOOR_S), home)
        if problem is not None:
            expired = time.monotonic() >= deadline
            # It was readable a moment ago, so this is transient. Never let it
            # become a verdict about the call.
            if expired:
                print(f"TIMEOUT — the audit log stopped being readable: {problem}")
                print(f"  The call WAS sent. Re-read the log for {nonce} once it is reachable.")
                return 1
        else:
            saw_any = saw_any or bool(events)
            if grace and any(r.get("event") == "intent_received"
                             and nonce in str(r.get("goal", "")) for r in events):
                grace = False
                # Back to the run's own deadline, never past it: the grace was
                # a floor on attention, not extra budget.
                deadline = full_deadline
                print(f"it arrived — waiting up to {remaining():.0f}s for a terminal event")
            # AFTER the extension: computing it at the top of the loop meant an
            # intent that first became visible on this very read was handed
            # `expired=True` and reported as timed out one line below the
            # message saying it had arrived.
            expired = time.monotonic() >= deadline
            outcome = verdict(events, nonce, expired, since)
            if outcome is not None:
                code, lines, arrived = outcome
                print("\n".join(lines))
                # Both hints annotate the nothing-carrying-the-nonce verdict,
                # so they hang off `arrived` — not off a non-zero exit, which
                # a DENIED also has, and a DENIED is proof the send arrived.
                # Every branch that reaches this loop carries one: `send`
                # returns early unless `unknown`, and all three unknown
                # branches set a hint.
                if not arrived and sent is not None:
                    print(sent[2])
                # Folding ENOENT into "empty" is right, but it makes a wrong
                # --home look exactly like a fresh install, and none of the
                # three causes above names that.
                if not arrived and not saw_any:
                    print(f"  Nothing has ever been written at {log_path} — normal on a")
                    print("  fresh install with nothing approved, and also what a wrong --home")
                    print('  looks like. From source: --home "$(just --evaluate apphome)".')
                return code
        # Bounded by the deadline: `--timeout 1` slept five seconds, so the
        # window an operator asked for was never the window they got.
        time.sleep(min(5.0, remaining()))


if __name__ == "__main__":
    sys.exit(main())
