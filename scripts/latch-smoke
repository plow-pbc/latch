#!/usr/bin/env python3
"""Prove an installed Latch works: one real MCP call, verified in the audit log.

The unit suite never opens a socket to a real relay (README-ts.md § Integration
coverage). This is the leg that does — MCP client → Plow relay → device socket →
`@domo/mcp-server` → the executor — and the audit log is the proof, not the
client's reply. A reply can come from a deferred handle or a half-working path;
an `exec_end` carrying our intent's id cannot.

One process on purpose. Send and Verify used to be two pasted blocks bridged by
copied shell variables across three interpreters, and every bug in them lived in
that seam: a credential in an error body, a success declared at `exec_start`
before any terminal event, and a wall-clock bound that could report "ruled out"
having checked nothing. Here the correlation id is held in a variable, the
baseline is a line count rather than a timestamp, and there is no quoting layer.

The nonce rides `goal`, never argv. `RuleKey.compute` hashes the capability set
and deliberately excludes goal text, so a fixed argv means one pre-seeded Always
Allow rule matches every run — which is what makes an unattended smoke possible
at all. A nonce in argv would mint a new rule key each time and raise a dialog
forever.
"""
import argparse
import json
import os
import shlex
import subprocess
import sys
import time
import urllib.error
import urllib.request

# The wire shape is NOT generic JSON-RPC: the server validates that the body's
# method and tool name agree with headers declaring them, and every request
# carries its envelope in `params._meta` — modern MCP is per-request, so there
# is no initialize handshake and no session to open first.
# `packages/mcp-server/test/client.ts` is the authority; keep this in step with
# it and with `PROTOCOL_REVISION` in `handler.ts`.
REVISION = "2026-07-28"
DEFAULT_HOME = "~/Library/Application Support/Plow-Latch"
# How long a call whose send RAISED is given to show up. `intent_received` is
# written the moment one arrives, so this is generous; it exists so a typo'd
# --url does not cost the full window.
ARRIVAL_GRACE_S = 20


def remote_cat(log_path):
    """The shell command that reads the log on the far side.

    Two jobs. `$HOME` expands THERE — the default home starts with `~`, and
    `shlex.quote` makes it a literal, so the remote shell would look for a
    directory actually named `~`. And a file that does not exist yet exits 3,
    distinctly from every other way `cat` can fail: a fresh install has no
    audit log until something is approved (`just audit` says so), and that is
    the case this script is written for, while a dead host and a permission
    refusal are not the same answer at all.
    """
    quoted = (f'"$HOME"/{shlex.quote(log_path[2:])}' if log_path.startswith("~/")
              else shlex.quote(log_path))
    return f"if [ -e {quoted} ]; then cat -- {quoted}; else exit 3; fi"


def read_log(log_path, ssh):
    """`(records, problem)` — every parseable audit record, or why there are none.

    A read that FAILED and a log with no evidence in it are different answers,
    and collapsing them is how a checker reports "ruled out" having opened
    nothing. A log that does not exist YET is the second kind: `AuditLog`
    creates the file on its first record, so a freshly installed build has none
    until something is approved. A permission error, a dead host and a
    `BatchMode` refusal are the first kind, and over ssh they are not even in
    the set of causes the timeout branch names.
    """
    if ssh:
        proc = subprocess.run(
            ["ssh", "-o", "ConnectTimeout=8", "-o", "BatchMode=yes", ssh, remote_cat(log_path)],
            capture_output=True, text=True,
        )
        if proc.returncode == 3:
            return [], None
        if proc.returncode != 0:
            # The LAST line, not the first: a known-hosts warning or a login
            # banner precedes the real error, and the one line that survives is
            # the operator's only clue about which of --home or --ssh is wrong.
            detail = [line for line in proc.stderr.strip().splitlines() if line.strip()]
            return [], f"ssh {ssh}: {detail[-1] if detail else 'exit ' + str(proc.returncode)}"
        raw = proc.stdout
    else:
        try:
            with open(log_path, errors="replace") as handle:
                raw = handle.read()
        except FileNotFoundError:
            raw = ""
        except OSError as error:
            return [], f"{log_path}: {error.strerror}"
    records = []
    for line in raw.splitlines():
        try:
            records.append(json.loads(line))
        except ValueError:
            continue
    return records, None


def send(url, token_file, argv, goal):
    """POST one `tools/call`. Returns None, or `(reason, unknown)`.

    `unknown` is the difference between a call that was refused and one whose
    fate nobody knows. Only the first is a reason to stop: the second is
    resolved by the poll loop, which is already primed with the baseline and
    holds the nonce, so handing it back as manual work would be giving up at
    the moment this is best equipped to answer it.

    The error body is NEVER printed. An authenticated response can repeat the
    bearer credential back, and this repo's contract (CLAUDE.md) is that such a
    response never becomes a verdict or a log line in any encoding. The status
    alone carries what the body was here for: the relay refuses with 401/403
    before the MCP handler is reached, and the handler's own refusals are 4xx
    from a server that already authenticated you.
    """
    with open(token_file) as handle:
        token = handle.read().strip()
    # `.strip()` removes SURROUNDING whitespace only, so a token pasted across
    # two lines keeps its newline — and `putheader` refuses it with a message
    # that quotes the header value. Caught here, where the file can be named
    # instead of its contents.
    if "\r" in token or "\n" in token:
        return (f"{token_file} has a line break inside the token.\n"
                "  Nothing was sent. Rewrite it as a single line.", False)
    name = "plow_run_command"
    body = json.dumps({
        "jsonrpc": "2.0", "id": 1, "method": "tools/call",
        "params": {
            "name": name,
            "arguments": {"argv": list(argv), "goal": goal},
            "_meta": {
                "io.modelcontextprotocol/protocolVersion": REVISION,
                "io.modelcontextprotocol/clientInfo": {"name": "latch-smoke", "version": "1"},
                "io.modelcontextprotocol/clientCapabilities": {},
            },
        },
    }).encode()
    try:
        request = urllib.request.Request(url, data=body, method="POST", headers={
            "Authorization": "Bearer " + token,
            "Content-Type": "application/json",
            "Accept": "application/json, text/event-stream",
            "MCP-Protocol-Version": REVISION,
            "MCP-Method": "tools/call",
            "MCP-Name": name,
        })
    except ValueError as error:
        # Its own branch, and its message is safe to quote: `full_url`'s setter
        # rejects a URL with no scheme and names the URL, which the operator
        # supplied and which this file already prints. Nothing has touched the
        # headers yet, so the credential cannot be in it.
        return (f"could not reach {url}: {error}.\n"
                "  The request never left this Mac; nothing was written to the log.", False)
    try:
        with urllib.request.urlopen(request, timeout=90) as response:
            payload = json.load(response)
    except urllib.error.HTTPError as error:
        # A RESPONSE arrived, so this branch actually knows something. A 4xx is
        # the relay or the MCP handler saying it refused. A 5xx is neither —
        # RELAY_TIMEOUT_MS is the relay abandoning an exchange it has ALREADY
        # forwarded, with the device holding the intent and the dialog up.
        if error.code >= 500:
            return (f"HTTP {error.code} — the relay gave up on an exchange it may"
                    " already have forwarded.", True)
        return (f"HTTP {error.code} — refused before it became an intent.\n"
                "  Nothing was written to the audit log. 401/403 is the relay or the"
                " credential; another 4xx is the MCP handler.", False)
    except Exception as error:
        # A RESPONSE is evidence. AN EXCEPTION IS NOT — and seven rounds of
        # review went into learning that. Each one classified some exception as
        # proof the call had or had not gone out, and each was wrong for one
        # more subclass: a 5xx, then every transport error, then a bare
        # `ConnectionResetError`, then `IncompleteRead`, then a scheme-less
        # URL, then `InvalidURL` and a `UnicodeEncodeError` out of `putheader`.
        #
        # So this no longer asks. There are no sides to put an exception on:
        # anything that is not a response means the call's fate is unknown, and
        # the audit log — the one thing that actually knows — is read below. A
        # call that never left costs a short grace window, which is the cheap
        # error; asserting an intent does not exist while the dialog is up is
        # the expensive one.
        # The CLASS NAME, never the message. `putheader` raises
        # `ValueError("Invalid header value %r" % value)` and the value here is
        # `b"Bearer <token>"` — verified by driving a real `urlopen` with a
        # newline in the token: the message carries the credential in full.
        # This branch catches every exception there is, so no audit of which
        # messages are safe could stay true; the class name always is.
        return (type(error).__name__, True)
    # Neither absence is proof of success — that is the audit log — but either
    # presence is proof of failure, and saying so now beats a 2-minute timeout.
    if payload.get("error") is not None:
        return (f"JSON-RPC error: {json.dumps(payload['error'])[:200]}\n"
                "  Refused before it became an intent; nothing was written to the log.", False)
    # `or {}` because a present-but-null `result` is None, and `.get` on it
    # raises rather than answering.
    if (payload.get("result") or {}).get("isError"):
        return ("the tool returned isError.\n"
                "  Refused inside the MCP layer; no intent was created.", False)
    return None


def split_command(raw):
    """`(options, command)`, split at the first `--`.

    Done by hand rather than with an `argparse` positional because the commands
    worth smoking carry flags of their own — `gog gmail search q --json` — and
    argparse rejects an option it does not recognise wherever it appears. A
    separator also keeps a mistyped script flag an error instead of silently
    becoming part of the command, which `parse_known_args` would not.
    """
    if "--" not in raw:
        return raw, []
    cut = raw.index("--")
    return raw[:cut], raw[cut + 1:]


def first(records, event):
    return next((r for r in records if r.get("event") == event), None)


def verdict(events, nonce, expired, since=0):
    """The whole outcome table, pure over the audit records.

    Returns `(exit_code, lines, arrived)`, or None while the call is still in
    flight and the window is still open. `arrived` is whether anything carrying
    the nonce was found at all, which is what the hints in `main` annotate —
    guarding those on a non-zero exit instead would print "the send failed"
    under a `DENIED`, which is itself proof the send arrived.

    Pure on purpose: this is where every bug in the two pasted shell blocks
    this script replaces actually lived, and a function over a list of records
    is the only version of it a test can reach.

    `intent_received` is the correlation point — it carries the goal, and so
    the nonce. Everything after it is anchored to its `intentId`, so no other
    traffic on a busy install can satisfy one of these conditions on a
    different call's record. Matching the nonce alone would not do: it is
    written BEFORE the decision, so a call the owner denied still carries it.
    """
    received = next((r for r in events if r.get("event") == "intent_received"
                     and nonce in str(r.get("goal", ""))), None)
    if received is None:
        if not expired:
            return None
        # The ONE scan that needs bounding: an `intent_rejected` carries no
        # nonce, so an old one is indistinguishable from this call's. Nothing
        # else does — the nonce carries a timestamp AND this process's pid, so
        # it identifies this call across the whole file. Slicing the records
        # instead would put correlation itself at the mercy of a count taken by
        # a separate read: a line still being appended when that read lands
        # parses as garbage and is dropped, the count comes back one short, and
        # the slice cuts off this call's own `intent_received`.
        # A log that SHRANK — `AuditLog.clear()` truncates — leaves `since`
        # indexing past the end, and the slice would be empty: "ruled out"
        # over records nothing examined, which is the shape this whole
        # function exists to prevent. A baseline that no longer indexes
        # anything bounds nothing, so scan it all.
        bound = since if since <= len(events) else 0
        rejected = [r for r in events[bound:] if r.get("event") == "intent_rejected"]
        lines = [f"TIMEOUT — nothing carrying {nonce}. Three causes:",
                 "  1. it never reached this install (wrong install, credential, or socket)",
                 "  2. refused in the MCP layer before an intent existed — writes NO audit line",
                 "  3. rejected at validate (wrong device / expired / replayed nonce), which",
                 "     writes intent_rejected WITHOUT the nonce:"]
        lines += ["     " + json.dumps(r) for r in rejected[-2:]]
        if not rejected:
            lines.append("     (none since this call started — cause 3 ruled out)")
        return 1, lines, False

    mine = [r for r in events if r.get("intentId") == received.get("intentId")]
    decision = first(mine, "intent_decision")
    if decision is not None and decision.get("decision") == "deny":
        return 1, [json.dumps(decision),
                   "DENIED — the owner refused it. The relay and the device both worked."], True
    end = first(mine, "exec_end")
    if end is not None:
        lines = [json.dumps(r) for r in (first(mine, "exec_start"), end) if r is not None]
        # `exec_start` alone was never proof: it is written before the spawn.
        # A run this Mac killed is not a command that succeeded either, and
        # `reaped` is the only place that difference survives.
        if end.get("exit_code") == 0 and not end.get("reaped"):
            return 0, lines + ["OK — it executed and exited 0. The whole path works."], True
        what = "was reaped by this Mac" if end.get("reaped") else f"exited {end.get('exit_code')}"
        return 1, lines + [f"FAILED — it ran and {what}."], True
    error = first(mine, "exec_error")
    if error is not None:
        return 1, [json.dumps(error), "FAILED — the executor threw before the command ran."], True
    if not expired:
        return None
    if decision is None:
        return 1, ["TIMEOUT — it reached this Mac and is sitting unanswered at the approval dialog.",
                   "  Not a plumbing problem. Seed an Always Allow rule for an unattended run."], True
    start = first(mine, "exec_start")
    if start is None:
        return 1, ["TIMEOUT — approved, never started. exec_start is written before the spawn,",
                   "  so its absence means the executor was never reached. Check the app is running."], True
    return 1, [json.dumps(start),
               "TIMEOUT — started, still running. Re-run to read its exec_end, or raise --timeout."], True


def main():
    # Progress is the point of the waiting lines, and Python block-buffers
    # stdout when it is a pipe — so `latch-smoke | tee run.log` showed nothing
    # at all until the run ended, which is exactly when it stops mattering.
    sys.stdout.reconfigure(line_buffering=True)
    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    parser.add_argument("--url", default=os.environ.get("MCP_URL"),
                        help="the install's mcpUrl (env: MCP_URL)")
    parser.add_argument("--token-file", default=os.environ.get("TOKEN_FILE"),
                        help="a 0600 file holding the bearer token (env: TOKEN_FILE)")
    parser.add_argument("--home", default=os.environ.get("LATCH_HOME", DEFAULT_HOME),
                        help=f"the instance home (default: {DEFAULT_HOME})")
    parser.add_argument("--ssh", default=None, metavar="USER@HOST",
                        help="read the audit log on another Mac over ssh")
    parser.add_argument("--timeout", type=int, default=120,
                        help="seconds to wait for a terminal event (default: 120)")
    parser.epilog = "Everything after `--` is the command to run."
    options, command = split_command(sys.argv[1:])
    args = parser.parse_args(options)
    if not args.url or not args.token_file:
        parser.error("--url and --token-file are required (or MCP_URL / TOKEN_FILE)")
    # A FIXED default, so one Always Allow rule covers every run. Passing a
    # command is how the gog path is smoked; that one needs its own rule.
    argv = command or ["/bin/echo", "latch-smoke"]

    home = args.home if args.ssh else os.path.expanduser(args.home)
    log_path = os.path.join(home, "device", "audit.ndjson")
    nonce = f"latch-smoke-{time.strftime('%Y%m%dT%H%M%SZ', time.gmtime())}-{os.getpid()}"
    print(f"nonce={nonce}")

    # Read BEFORE sending, and refuse on a read that failed. This is the one
    # moment where refusing costs nothing: past it, the call has raised a
    # dialog on someone's Mac that nothing here can then verify. It is the same
    # reasoning the send-side guards use, one layer down.
    baseline, problem = read_log(log_path, args.ssh)
    if problem is not None:
        print(f"REFUSED — cannot read the audit log: {problem}")
        print("  Not sending: a call this cannot verify would still raise a dialog.")
        print("  A missing log is NOT this — that is normal on a fresh install and reads")
        print("  as empty. This is a host, a permission, or an unreadable --home.")
        return 1
    # Positional, and it bounds ONE thing: the nonce-less `intent_rejected`
    # scan. No clock is involved — the operator's clock and the target's are
    # not the same clock on the ssh path, and a skewed bound reports "ruled
    # out" having checked nothing, which tells someone to stop looking.
    since = len(baseline)

    sent = send(args.url, args.token_file, argv, f"smoke test: {nonce}")
    if sent is not None:
        reason, unknown = sent
        if not unknown:
            print(f"REFUSED — {reason}")
            return 1
        print(f"UNVERIFIED — {reason}")

    # `intent_received` is written on arrival, before the dialog, so a short
    # look answers "did it get there?" from evidence rather than from the
    # exception's class. Extended to the full window the moment it appears.
    grace = sent is not None
    # Never longer than what was asked for: `--timeout 1` means one second,
    # grace included.
    window = min(ARRIVAL_GRACE_S, args.timeout) if grace else args.timeout
    started = time.monotonic()
    print(f"waiting up to {window}s"
          f"{' for it to arrive at all' if grace else ' for a terminal event'}")
    deadline = started + window
    # The baseline was read from the same path a moment ago; records in it are
    # evidence the path is right, which is all the hint below asserts against.
    saw_any = bool(baseline)
    while True:
        events, problem = read_log(log_path, args.ssh)
        if problem is not None:
            expired = time.monotonic() >= deadline
            # It was readable a moment ago, so this is transient. Never let it
            # become a verdict about the call.
            if expired:
                print(f"TIMEOUT — the audit log stopped being readable: {problem}")
                print(f"  The call WAS sent. Re-read the log for {nonce} once it is reachable.")
                return 1
        else:
            saw_any = saw_any or bool(events)
            if grace and any(r.get("event") == "intent_received"
                             and nonce in str(r.get("goal", "")) for r in events):
                grace = False
                deadline = started + args.timeout
                print(f"it arrived — waiting up to {args.timeout}s for a terminal event")
            # AFTER the extension: computing it at the top of the loop meant an
            # intent that first became visible on this very read was handed
            # `expired=True` and reported as timed out one line below the
            # message saying it had arrived.
            expired = time.monotonic() >= deadline
            outcome = verdict(events, nonce, expired, since)
            if outcome is not None:
                code, lines, arrived = outcome
                print("\n".join(lines))
                # Both hints annotate the nothing-carrying-the-nonce verdict,
                # so they hang off `arrived` — not off a non-zero exit, which
                # a DENIED also has, and a DENIED is proof the send arrived.
                if not arrived and sent is not None:
                    print("  The send itself failed — see UNVERIFIED above, which is"
                          " the likeliest cause of all three.")
                # Folding ENOENT into "empty" is right, but it makes a wrong
                # --home look exactly like a fresh install, and none of the
                # three causes above names that.
                if not arrived and not saw_any:
                    print(f"  Nothing has ever been written at {log_path} — normal on a")
                    print("  fresh install with nothing approved, and also what a wrong --home")
                    print("  looks like (a from-source run is Plow-Latch-<branch>).")
                return code
        time.sleep(5)


if __name__ == "__main__":
    sys.exit(main())
